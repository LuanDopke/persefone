  "context": [
    "area: backend authentication and access routes",
    "area: frontend access screen and authenticated shell",
    "constraint: passwordless email link, one-day session, derived display name"
  ],
  "intent": "Permitir acesso e criação de conta por e-mail sem senha, com sessão de um dia e saída pela interface.",
  "expectations": [
    "Não há fluxo de senha nesta funcionalidade."
  ],
  "approach": "Adicionar o aplicativo accounts com perfil de e-mail único e solicitações de acesso com token aleatório armazenado por hash. O frontend centraliza a sessão no AuthContext, protege as rotas existentes e persiste somente o JWT de 24 horas.",
  "decisions": [
    {
      "decision": "Usar AccountProfile com User nativo",
      "why": "preserva a integração Django existente e garante unicidade do e-mail",
      "rejected": "substituir AUTH_USER_MODEL após a estrutura inicial"
    },
    {
      "decision": "Usar token aleatório com hash para o link",
      "why": "permite expiração e uso único auditáveis sem persistir o segredo",
      "rejected": "JWT diretamente no link"
    },
    {
      "decision": "Emitir somente JWT de acesso de 1 dia",
      "why": "a infraestrutura SimpleJWT e o cliente Axios já existem e não haverá renovação silenciosa",
      "rejected": "refresh token ou limite atual de 12 horas"
    },
    {
      "decision": "Armazenar somente hash SHA-256 do token de acesso",
      "why": "o segredo não permanece persistido e o uso único pode ser confirmado atomicamente",
      "rejected": "persistir o token em texto simples"
    }
  ],
